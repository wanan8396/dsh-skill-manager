{
  "name": "@local/skill-manager",
  "version": "1.0.0",
  "private": true,
  "description": "Skill manager for DeepSeek Harness (DSH): a sidebar row and page to install, import and delete local SKILL.md skills.",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "host.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "skills",
    "agent-skills"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wanan8396/dsh-skill-manager.git"
  },
  "homepage": "https://github.com/wanan8396/dsh-skill-manager#readme",
  "bugs": {
    "url": "https://github.com/wanan8396/dsh-skill-manager/issues"
  }
}
